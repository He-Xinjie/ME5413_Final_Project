<launch>

  <!-- Keyboard teleop (optional, launch separately in a terminal if needed) -->
  <!-- <node name="teleop_twist_keyboard" pkg="teleop_twist_keyboard" type="teleop_twist_keyboard.py" output="screen" respawn="true"/> -->

  <!-- Map server -->
  <arg name="map_file" default="$(find me5413_team_solution)/maps/final/2Dmap/final_map_v2.yaml"/>
  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" />

  <!-- AMCL Localization -->
  <include file="$(find jackal_navigation)/launch/include/amcl.launch" />

  <!-- Custom Move Base with DWA -->
  <include file="$(find me5413_team_solution)/launch/move_base.launch" />

  <!-- RViz -->
  <node type="rviz" name="rviz" pkg="rviz" args="-d $(find me5413_world)/rviz/navigation.rviz" output="log" respawn="true"/>

  <!-- Goal Publisher (for error metrics) -->
  <node ns="me5413_world" pkg="me5413_world" type="goal_publisher_node" name="goal_publisher_node" output="screen" />

  <!-- Box Detector 3D (RGB-D based, 3D clustering deduplication) -->
  <node pkg="me5413_team_solution" type="box_detector_3d.py" name="box_detector_3d" output="screen" />

  <!-- Mission Planner State Machine -->
  <arg name="auto_start" default="false" />
  <node pkg="me5413_team_solution" type="mission_planner.py" name="mission_planner" output="screen">
    <param name="auto_start" value="$(arg auto_start)" />
  </node>

  <!-- Zone Navigator (listens to /nav_zone/command from RViz panel) -->
  <node pkg="me5413_team_solution" type="nav_test.py" name="zone_navigator" output="screen" />

</launch>
